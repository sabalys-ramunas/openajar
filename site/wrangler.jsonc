// openajar.com: the landing page, as a Worker with static assets only (no script).
// Deploy from this folder with `npx wrangler deploy` (see README.md).
{
  "name": "openajar-site",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    // An unknown path gets public/404.html with a 404 status.
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  // A route on the zone's proxied DNS record (the record that came with the domain stays; the Worker answers
  // every request before it). www.openajar.com needs a proxied DNS record of its own before it can be added
  // here as "www.openajar.com/*".
  "routes": [
    { "pattern": "openajar.com/*", "zone_name": "openajar.com" }
  ],
  "workers_dev": false,
  "preview_urls": false
}
